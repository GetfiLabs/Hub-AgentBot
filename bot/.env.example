# Telegram Bot Token (@BotFather'dan alınır)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# İzole Firebase (Bot Hafızası) — Service Account JSON dosyası yolu
# Bu JSON, ana oyunun DEĞİL, sadece bota ait izole Firebase projesinin yetki belgesidir.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Roll Raider Players API — canonical source for player stats + currency (G).
# Bot, oyun veritabanına doğrudan BAĞLANMAZ; sadece bu API üzerinden HTTP ile
# okur ve idempotent delta yazar (PLAYERS_API.md kontratı).
# Auth: X-API-Key header (NOT Bearer).
GAME_API_BASE_URL=https://europe-central2-wikzrollraider.cloudfunctions.net/playersApi/v1
GAME_API_KEY=

# OpenAI Vector Store ID (Adım 2 — Bilgi Bankası)
# "node src/scripts/setupVectorStore.js create" ile oluştur, çıkan ID'yi buraya yapıştır
OPENAI_VECTOR_STORE_ID=

# Ekip Telegram Grup Chat ID (Adım 3 için)
TEAM_GROUP_CHAT_ID=your_team_group_chat_id

# ──────────── Phase 3 — On-chain agent box opening ────────────

# Devnet için varsayılan; mainnet'e geçişte Helius/QuickNode RPC URL'i ekle.
SOLANA_RPC_URL=https://api.devnet.solana.com

# getfi_lootbox program ID'si (devnet ile aynı, mainnet'te değişebilir).
GETFI_LOOTBOX_PROGRAM_ID=Bm6zsJgc87Hj6gGEtpHtyjP89Lwuu7TequM6dgPL8LA7

# Hub Functions HTTP endpoint — `signAgentBoxOpen` deploy edildikten
# sonra Firebase'in verdiği URL'yi yapıştır (örn:
# https://us-central1-<project>.cloudfunctions.net/signAgentBoxOpen).
HUB_SIGN_AGENT_BOX_URL=

# Hub'daki BOT_AGENT_SHARED_SECRET ile aynı değer olmalı (Bearer auth).
BOT_AGENT_SHARED_SECRET=

# 32 byte (hex veya base64) — bot'un Firestore'da tuttuğu şifreli agent
# secret key'lerini açar. `openssl rand -hex 32` ile üret.
BOT_AGENT_MASTER_KEY=

# Opsiyonel — node-cron ifadesi (varsayılan: her 6 saatte bir).
# AGENT_CRON_SCHEDULE=0 */6 * * *

# Bot'un operasyonel hot wallet'ı — her kullanıcının agent keypair'ine
# ufak bir SOL avansı geçer (tx fee için, zincirde reimburse edilir).
# `solana-keygen new -o ./bot-op.json` ile üret, JSON-array içeriğini
# (köşeli parantezli sayı listesi) buraya yapıştır. Bot'un toplam SOL
# tüketimi pratikte sıfıra yakındır; her kullanıcı için tek seferlik
# ~0.005 SOL seed yeter.
BOT_OPERATIONAL_WALLET_SECRET=

# Hub'daki "Ajanı Yetkilendir" sayfasının URL'i — /agentbaglan cevabında
# kullanıcıya direkt link olarak gösterilir.
HUB_AGENT_PAGE_URL=
